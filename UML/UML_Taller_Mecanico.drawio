ar(r: Reparacion, estado: EstadoReparacion, inicio: LocalDate, fin: LocalDate): void&lt;br&gt;+agregarTurno(t: Turno): boolean&lt;br&gt;+agregarTurnoDeCliente(dniCliente: String, t: Turno): boolean&lt;br&gt;+buscarTurno(id: int): Turno&lt;br&gt;+listarTurnos(): List&amp;lt;Turno&amp;gt;&lt;br&gt;+listarTurnosPorCliente(dniCliente: String): List&amp;lt;Turno&amp;gt;&lt;br&gt;+modificarTurno(id: int, nuevoDniMecanico: String, nuevaFecha: LocalDate): boolean&lt;br&gt;+cancelarTurno(id: int): boolean&lt;br&gt;+cancelarTurnoDeCliente(dniCliente: String, id: int): boolean&lt;br&gt;+marcarTurnoAtendido(id: int): boolean&lt;br&gt;-reemplazarTurno(nuevo: Turno): void&lt;br&gt;-turnoPerteneceACliente(t: Turno, dniCliente: String): boolean&lt;br&gt;-buscarVehiculoONull(patente: String): Vehiculo&lt;br&gt;-obtenerClienteActivo(dni: String): Cliente&lt;br&gt;-obtenerVehiculoActivo(patente: String): Vehiculo&lt;br&gt;-obtenerMecanicoActivo(dni: String): Empleado&lt;br&gt;-validarFechaNoPasada(fecha: LocalDate): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="p5-c4">
